{
  "name": "cf7-mcp-server",
  "version": "1.3.1",
  "description": "Model Context Protocol (MCP) server for Contact Form 7 WordPress integration, multi-site management, and agency integrations",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "cf7-lint": "./dist/cli/lint.js"
  },
  "scripts": {
